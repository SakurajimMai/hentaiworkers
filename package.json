{
  "name": "anime-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:ts && npm run test:python",
    "test:ts": "tsx --test \"tests/**/*.test.ts\"",
    "test:python": "node scripts/run-python-tests.mjs",
    "check:legacy": "node scripts/check-no-legacy.mjs",
    "db:baseline": "node scripts/export-schema-baseline.mjs",
    "db:migrate:crawler": "node scripts/apply-crawler-migration.mjs",
    "db:push": "node -e \"throw new Error('db:push is disabled; use reviewed migrations')\"",
    "db:studio": "drizzle-kit studio",
    "seed:admin": "tsx scripts/seed-admin.ts"
  },
  "dependencies": {
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "iron-session": "^8.0.4",
    "mysql2": "^3.14.1",
    "next": "^15.5.20",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.20",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
