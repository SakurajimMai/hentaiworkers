# Image-only production operations: schema setup/migrations and first admin seed.
FROM node:22-alpine

ENV NODE_ENV=production \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false

RUN addgroup -S -g 10002 ops \
    && adduser -S -D -H -u 10002 -G ops ops \
    && mkdir -p /ops \
    && chown ops:ops /ops

WORKDIR /ops

COPY ops/package.json ops/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts \
    && npm cache clean --force

COPY --chown=ops:ops scripts/apply-crawler-migration.mjs scripts/setup-crawler-core.mjs scripts/setup-production-baseline.mjs scripts/seed-admin-ops.mjs scripts/ops-entrypoint.mjs ./scripts/
COPY --chown=ops:ops scripts/lib/migration-connection.mjs scripts/lib/sql-compat.mjs ./scripts/lib/
COPY --chown=ops:ops drizzle/migrations ./drizzle/migrations
COPY --chown=ops:ops drizzle/core ./drizzle/core
COPY --chown=ops:ops drizzle/baseline ./drizzle/baseline

USER ops:ops

ENTRYPOINT ["node", "scripts/ops-entrypoint.mjs"]
CMD ["migrate"]
