# Remote MySQL (URL-encode special chars in password, e.g. @ → %40)
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# TLS is required by default. Only localhost/127.0.0.1/::1 may use disabled.
DATABASE_TLS_MODE=required
# Optional PEM CA path relative to the repository root; omit to use system CAs.
# DATABASE_TLS_CA_FILE=certificates/mariadb-ca.pem
# Database pool limits and timeouts in milliseconds.
DATABASE_POOL_CONNECTION_LIMIT=8
DATABASE_POOL_MAX_IDLE=4
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=20000

# Public canonical URL used by sitemap generation
SITE_URL=https://anime.ixacg.top

# Session encryption (min 32 characters). Generate: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret-string

# AES-256-GCM keyring for SMTP / Turnstile / crawler secrets in DB.
# Each value must be canonical Base64 for exactly 32 bytes.
# Generate: openssl rand -base64 32
# Production: required. Do not ship the placeholder string below.
APP_ENCRYPTION_KEYRING={"primary":"replace-with-canonical-base64-32-byte-key"}
APP_ENCRYPTION_CURRENT_KEY_ID=primary
# See docs/deployment.md for Compose production setup.

# Create first admin if none exist (used by npm run seed:admin)
ADMIN_BOOTSTRAP_USER=admin@ixacg.top
ADMIN_BOOTSTRAP_PASSWORD=change-me-please

# --- Docker Compose / Hub (optional) ---
# DOCKERHUB_USERNAME=yourhubuser
# APP_IMAGE_TAG=latest
# WORKER_IMAGE_TAG=latest
# APP_HOST_BIND=127.0.0.1
# APP_PORT=3000

# Optional crawler worker (compose --profile worker)
# CRAWLER_WORKER_ID=1
# CRAWLER_WORKER_TOKEN=replace-with-a-long-random-worker-token
# Storage capabilities are auto-detected from credentials below. Override only
# when credentials are supplied by an external broker at runtime.
# CRAWLER_STORAGE_DRIVERS=s3,sftp
# CRAWLER_S3_ACCESS_KEY_ID=
# CRAWLER_S3_SECRET_ACCESS_KEY=
# CRAWLER_S3_SESSION_TOKEN=
# CRAWLER_SFTP_PASSWORD=
# CRAWLER_SFTP_PRIVATE_KEY=/run/secrets/crawler_sftp_key
