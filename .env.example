# Application container environment.
# Host publish: APP_HOST_BIND:APP_PORT -> container :3000
APP_HOST_BIND=127.0.0.1
APP_PORT=13000

# Externally managed remote MySQL / MariaDB.
# URL-encode special password characters, e.g. @ -> %40, # -> %23.
DATABASE_URL=
DATABASE_TLS_MODE=required
DATABASE_POOL_CONNECTION_LIMIT=8
DATABASE_POOL_MAX_IDLE=4
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=5000

# Public canonical origin. Required in production; no path/query/hash.
SITE_URL=

# Image host proxied by /cdn-img/** (absolute HTTP(S) origin, no path). Empty disables the proxy.
IMAGE_PROXY_UPSTREAM=

# GitHub repository (owner/name) whose Releases publish the Android APKs. Empty disables /api/android/update.
ANDROID_UPDATE_REPOSITORY=

# Optional: override the IndexNow submission endpoint (defaults to the shared api.indexnow.org endpoint).
# INDEXNOW_ENDPOINT=

# Application image used by docker-compose.yml (owner/name); the tag comes from IMAGE_TAG.
APP_IMAGE=

# Manga: no env required for site connection.
# Configure publish secret in Admin → 系统设置 → 漫画发布密钥.
# Workers call POST /api/manga/publish with header X-Manga-Publish-Key.

# Session encryption. Generate: openssl rand -base64 48
SESSION_SECRET=

# AES-256-GCM keyring used for encrypted settings already stored in the remote DB.
# Each value is canonical Base64 for exactly 32 bytes. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEYRING=
APP_ENCRYPTION_CURRENT_KEY_ID=primary
