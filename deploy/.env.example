# Copy to .env next to deploy/docker-compose.yml and chmod 600.
# Production website deploy via Docker Hub — no git build required.

# --- Docker Hub (required for this compose file) ---
DOCKERHUB_USERNAME=
APP_IMAGE_TAG=latest
# WORKER_IMAGE_TAG=latest

# Host publish: <bind>:<port> -> container :3000
APP_HOST_BIND=127.0.0.1
APP_PORT=13000

# --- App (required) ---
DATABASE_URL=
DATABASE_TLS_MODE=required

SITE_URL=

# openssl rand -base64 48
SESSION_SECRET=

# openssl rand -base64 32  → put inside JSON
APP_ENCRYPTION_KEYRING=
APP_ENCRYPTION_CURRENT_KEY_ID=primary

# --- First admin seed only (run once; remove after success) ---
ADMIN_BOOTSTRAP_USER=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Optional crawler worker (only with: docker compose --profile worker) ---
# CRAWLER_WORKER_ID=1
# CRAWLER_WORKER_TOKEN=
