# Application container production environment.
# Compose pulls APP_IMAGE:IMAGE_TAG from the configured registry.
# Copy to .env next to docker-compose.yml and chmod 600.

# Application image (owner/name) and the immutable tag to deploy.
APP_IMAGE=
IMAGE_TAG=
PULL_POLICY=always

# Host publish: APP_HOST_BIND:APP_PORT -> container :3000
APP_HOST_BIND=127.0.0.1
APP_PORT=13000

# Externally managed remote MySQL / MariaDB.
DATABASE_URL=
DATABASE_TLS_MODE=required
DATABASE_POOL_CONNECTION_LIMIT=8
DATABASE_POOL_MAX_IDLE=4
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=5000

# Public canonical origin. No path/query/hash.
SITE_URL=

# Image host proxied by /cdn-img/** (absolute HTTP(S) origin, no path). Required for the Android client's images.
IMAGE_PROXY_UPSTREAM=

# GitHub repository (owner/name) whose Releases publish the Android APKs. Empty disables /api/android/update.
ANDROID_UPDATE_REPOSITORY=

# Optional: override the IndexNow submission endpoint.
# INDEXNOW_ENDPOINT=

# Generate: openssl rand -base64 48
SESSION_SECRET=

# Generate key: openssl rand -base64 32
APP_ENCRYPTION_KEYRING=
APP_ENCRYPTION_CURRENT_KEY_ID=primary
