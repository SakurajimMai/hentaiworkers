# App container production environment. Worker identity belongs in worker.env.
# Compose pulls public image: sakurajiamai/hentaiworkers-app:latest
# Copy to .env next to docker-compose.yml and chmod 600.

# Host publish: APP_HOST_BIND:APP_PORT -> container :3000
APP_HOST_BIND=127.0.0.1
APP_PORT=13000

# Externally managed remote MySQL / MariaDB.
DATABASE_URL=
DATABASE_TLS_MODE=required
DATABASE_POOL_CONNECTION_LIMIT=8
DATABASE_POOL_MAX_IDLE=4
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=20000

# Public canonical origin. No path/query/hash.
SITE_URL=

# Generate: openssl rand -base64 48
SESSION_SECRET=

# Generate key: openssl rand -base64 32
APP_ENCRYPTION_KEYRING=
APP_ENCRYPTION_CURRENT_KEY_ID=primary
