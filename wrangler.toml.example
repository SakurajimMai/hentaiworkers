name = "your-project-name"
compatibility_date = "2024-09-23"
compatibility_flags = ["nodejs_compat"]
pages_build_output_dir = "dist"

# Database Configuration
# 设置 DB_TYPE 环境变量来选择数据库:
# - "d1" (默认推荐): 使用 Cloudflare D1 (SQLite)
# - "hyperdrive": 使用 MySQL + Hyperdrive

# D1 Database (默认推荐)
[[d1_databases]]
binding = "DB"
database_name = "your-d1-database-name"
database_id = "your-d1-database-id"

# Hyperdrive (MySQL) - 可选
[[hyperdrive]]
binding = "HYPERDRIVE"
id = "your-hyperdrive-id"

# 环境变量配置
[vars]
DB_TYPE = "d1"  # 可选: "d1" 或 "hyperdrive"

# 本地开发时的 MySQL 连接 (仅当 DB_TYPE = "hyperdrive")
# localConnectionString = "mysql://user:password@host:3306/database"
